# Signing key and Sepolia RPC
PRIVATE_KEY=your_private_key_here
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Optional Etherscan verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Deployed platform address used by deployment and verification scripts
BUCKET_INFO_ADDRESS=deployed_bucket_info_address
IMPLEMENTATION_REGISTRY_ADDRESS=deployed_implementation_registry_address

# Addresses emitted by vault deployment scripts
ACTIVE_BUCKET_IMPL_ADDRESS=deployed_active_bucket_implementation_address
ACTIVE_BUCKET_FACTORY_ADDRESS=deployed_active_bucket_factory_address
ACTIVE_BUCKET_PROXY_ADDRESS=deployed_active_bucket_proxy_address

PASSIVE_BUCKET_IMPL_ADDRESS=deployed_passive_bucket_implementation_address
PASSIVE_BUCKET_FACTORY_ADDRESS=deployed_passive_bucket_factory_address
PASSIVE_BUCKET_PROXY_ADDRESS=deployed_passive_bucket_proxy_address

PURE_MEMBERSHIP_IMPL_ADDRESS=deployed_pure_membership_implementation_address
PURE_MEMBERSHIP_FACTORY_ADDRESS=deployed_pure_membership_factory_address
PURE_MEMBERSHIP_PROXY_ADDRESS=deployed_pure_membership_proxy_address

POTENTIAL_RUGPULL_FACTORY_ADDRESS=deployed_potential_rugpull_factory_address
POTENTIAL_RUGPULL_ADDRESS=deployed_potential_rugpull_address
POTENTIAL_RUGPULL_IMPL_ADDRESS=not_applicable_non_upgradeable

# Optional test fixture token
TEST_TOKEN_ADDRESS=test_token_address

# Optional Sepolia smoke transactions (scripts remain read-only unless explicitly set).
# Set CONFIRM_SEPOLIA_TEST_TRANSACTIONS=YES in the calling shell only after reviewing
# the specific SMOKE_* amount/token arguments. Do not enable by default in this file.
# Use a dedicated funded Sepolia test wallet through SMOKE_PRIVATE_KEY. Example one-off commands:
# CONFIRM_SEPOLIA_TEST_TRANSACTIONS=YES SMOKE_PRIVATE_KEY=... SMOKE_DEPOSIT_WEI=500000000000000000 SMOKE_REBALANCE=YES SMOKE_REDEEM_BPS=5000 ./script/test-passivebucket-sepolia.sh
# CONFIRM_SEPOLIA_TEST_TRANSACTIONS=YES SMOKE_PRIVATE_KEY=... SMOKE_DEPOSIT_WEI=100000000000000000 SMOKE_REDEEM_FOR_STABLE_BPS=8000 SMOKE_STABLE_TOKEN_SYMBOL=USDC SMOKE_MAX_SLIPPAGE_BPS=50 ./script/test-activebucket-sepolia.sh
# CONFIRM_SEPOLIA_TEST_TRANSACTIONS=YES SMOKE_PRIVATE_KEY=... SMOKE_MEMBERSHIP_TOKEN_ID=1 SMOKE_MEMBERSHIP_PAY_SECTION=1 ./script/test-puremembership-sepolia.sh
